# 生产环境的开关（Vite 只在 npm run build 时读这个文件，npm run dev 不受影响）
#
# 为什么必须要有这个文件：
#   src/api/config.js 里写的是 USE_MOCK = (VITE_USE_MOCK !== 'false')，
#   也就是"没配置就当 mock"。这个设计是为了保护刚 clone 下来、还没有 .env 的组员。
#   但它有个副作用：如果直接打包上线，前端会连"假数据"跑得好好的，
#   看起来一切正常，实际一条真实请求都没发出去 —— 很难发现。
#   所以这里显式写成 false，把"上线连真后端"钉死。
#
# 这两个值都不含密码，可以放心提交。

VITE_USE_MOCK=false

# 接口前缀。上线后前端和接口在同一个域名下（Nginx 把 /api 转给后端），
# 所以保持相对路径 /api 就对了，不用写服务器 IP。
VITE_API_BASE=/api
