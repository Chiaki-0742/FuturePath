# ============================================================
#  后端环境配置模板
#
#  这是模板文件。它会被提交到 Git，供组员参考。
#  真正生效的文件叫 .env（不提交，因为被 .gitignore 排除了）。
#
#  怎么用：在 backend/ 目录下把本文件复制一份，改名为 .env，
#          然后把下面那行里的「你的密码」换成你自己 MySQL 的 root 密码。
#
#  ⚠️ 不建 .env 会发生什么：
#     app/config.py 里的兜底值会连到 SQLite（backend/instance/dev.db）。
#     接口调用看起来一切正常，但数据存进了一个小文件而不是 MySQL ——
#     去数据库查询会发现"什么都没有"。第一周已经踩过一次这个坑。
#
#  ⚠️ 建 .env 之前先建库：
#     在 MySQL 里执行一遍 backend/init.sql（6 张表 + 题库9题 + 案例18条）。
# ============================================================

# 【最重要的一行】数据库连接串
#   格式：mysql+pymysql://用户名:密码@地址:端口/库名?charset=utf8mb4
#
#   ★ 库名从第二阶段起是 futurepath（第一周的 planning_db 已废弃）
#   ★ 密码换成自己电脑上 MySQL root 的密码，不要照抄这里的占位文字
#   ★ 末尾的 ?charset=utf8mb4 不能少：
#     少了它中文会存成 ??（第一周用 PowerShell 注册时踩过，HEX 是 3F3F）
DATABASE_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/futurepath?charset=utf8mb4

# token 签名用的密钥。本地开发随便填一个，
# ★ 正式部署必须换成一段随机长字符串，生成命令：
#     python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=futurepath-dev-secret-2026

# 本地开发开关：=1 时 python run.py 会开启「改代码自动重启 + 报错页显示堆栈」。
# 不写 = 关闭（run.py 启动时会打印一行提示）。
# ★ 上线环境千万不要打开：debug 模式会暴露 Werkzeug 调试器，
#   那个页面能在浏览器里执行任意代码。上线用 gunicorn 启动，本来也不读这个变量。
# FLASK_DEBUG=1

# 允许跨域的来源，逗号分隔。
# 不写这一行 = 允许所有来源（与改造前一致，组员局域网联调靠它，别随便删）。
# 只在「前后端分域名部署」时才需要收紧，例如：
#     CORS_ORIGINS=http://123.45.67.89
# 按 Nginx 同源部署（本项目推荐方案）时浏览器不发跨域请求，这一项用不到。
# CORS_ORIGINS=


# ============================================================
#  大模型配置（第三层 · POST /api/chat）
#
#  ✅ 当前状态：已接入智谱 GLM（open.bigmodel.cn），
#     真正调用的代码在 backend/app/routes/chat.py 的 call_real_model()。
#
#  两种模式自动切换（刻意留的降级，不要删）：
#     配了 LLM_API_KEY  → 真调模型，返回 data.mock = false
#     没配（如组员本地没建 .env）→ 退回固定文案，data.mock = true
#     前端靠 mock 字段显示"演示模式"，前端代码不用改。
#
#  ⚠️⚠️ API key 绝不能提交到 Git：
#     .env 已被 .gitignore 排除，只有 .env.example（这个模板）才会进仓库。
#     所以 key 写在 .env 里，不要写在 .env.example 或任何 .py 文件中。
#     （第一周发生过 api-test.http 泄露 token 和数据库密码的事故，务必长记性）
# ============================================================

# 从智谱平台拿到的 API Key（不填 = 走固定文案的演示模式）
LLM_API_KEY=

# 接口地址。不填用默认 https://open.bigmodel.cn/api/paas/v4
LLM_BASE_URL=

# 模型名。不填用默认 glm-4.5-air
# ⚠️ 别换 glm-5.3-flash / glm-4.7 这类"先想再答"的推理模型：
#    它们会把 max_tokens 全花在思考上，正文一个字都写不出来（2026-10-14 实测）
LLM_MODEL=
