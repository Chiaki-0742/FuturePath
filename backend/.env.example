# ============================================================
#  后端环境配置模板
#
#  这是模板文件。它会被提交到 Git，供组员参考。
#  真正生效的文件叫 .env（不提交，因为被 .gitignore 排除了）。
#
#  怎么用：在 backend/ 目录下把本文件复制一份，改名为 .env，
#          然后把下面那行里的「你的密码」换成你自己 MySQL 的 root 密码。
#
#  ⚠️ 不建 .env 会发生什么：
#     app/config.py 里的兜底值会连到 SQLite（backend/instance/dev.db）。
#     接口调用看起来一切正常，但数据存进了一个小文件而不是 MySQL ——
#     去数据库查询会发现"什么都没有"。第一周已经踩过一次这个坑。
#
#  ⚠️ 建 .env 之前先建库：
#     在 MySQL 里执行一遍 backend/init.sql（6 张表 + 题库9题 + 案例10条）。
# ============================================================

# 【最重要的一行】数据库连接串
#   格式：mysql+pymysql://用户名:密码@地址:端口/库名?charset=utf8mb4
#
#   ★ 库名从第二阶段起是 futurepath（第一周的 planning_db 已废弃）
#   ★ 密码换成自己电脑上 MySQL root 的密码，不要照抄这里的占位文字
#   ★ 末尾的 ?charset=utf8mb4 不能少：
#     少了它中文会存成 ??（第一周用 PowerShell 注册时踩过，HEX 是 3F3F）
DATABASE_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/futurepath?charset=utf8mb4

# token 签名用的密钥。本地开发随便填一个，
# 正式部署时要换成一段随机的长字符串（这个值泄露等于登录态可被伪造）。
SECRET_KEY=futurepath-dev-secret-2026
